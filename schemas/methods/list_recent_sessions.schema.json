{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "list_recent_sessions output",
  "description": "Output schema for directly resumable, top-level sessions returned by list_recent_sessions. Subagent and other parented child-session artifacts must not be emitted.",
  "type": "object",
  "required": ["sessions"],
  "properties": {
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "cwd", "lastActive"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Unique session identifier."
          },
          "name": {
            "oneOf": [
              { "type": "string" },
              { "type": "null" }
            ],
            "description": "Optional human-readable session name."
          },
          "cwd": {
            "type": "string",
            "minLength": 1,
            "description": "Working directory of the session."
          },
          "lastActive": {
            "type": "string",
            "description": "ISO 8601 timestamp of last activity."
          },
          "sourcePath": {
            "type": "string",
            "minLength": 1,
            "description": "Optional absolute source transcript path for index freshness checks."
          },
          "sourceMtimeNanos": {
            "type": "integer",
            "description": "Optional source transcript mtime as Unix nanoseconds."
          },
          "sourceSize": {
            "type": "integer",
            "minimum": 0,
            "description": "Optional source transcript size in bytes."
          }
        },
        "additionalProperties": false
      },
      "description": "Directly resumable top-level sessions, sorted by actual last activity descending."
    }
  },
  "additionalProperties": false
}
