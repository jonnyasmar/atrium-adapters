{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jonnyasmar/atrium-adapters/main/schemas/hq-library.schema.json",
  "title": "atrium HQ library",
  "description": "Curated director personas, routines and staff templates (hq/library.json), compiled from hq/library/**/*.md by scripts/build-hq-library.mjs. A client validates each bundle on its own against #/$defs/bundle and skips one it can't read, so a new kind or field never empties an older client's library.",
  "type": "object",
  "required": ["schemaVersion", "updatedAt", "bundles"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "updatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "bundles": {
      "type": "array",
      "items": { "$ref": "#/$defs/bundle" }
    }
  },
  "$defs": {
    "bundle": {
      "allOf": [
        {
          "oneOf": [
            {
              "$ref": "#/$defs/persona"
            },
            {
              "$ref": "#/$defs/routine"
            },
            {
              "$ref": "#/$defs/staff"
            }
          ]
        },
        {
          "$ref": "#/$defs/printable"
        }
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}/[a-z0-9][a-z0-9-]{0,63}$"
    },
    "text": { "type": "string", "minLength": 1 },
    "icon": {
      "description": "A lucide icon name in PascalCase, as atrium's labels name them (`Inbox`, `GitPullRequest`). A client that doesn't know it shows its default.",
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]{0,39}$"
    },
    "category": {
      "enum": ["communication", "engineering", "growth", "career", "life", "money"]
    },
    "effect": {
      "enum": ["read", "notify", "draft", "organise", "send", "post", "buy", "delete"]
    },
    "tier": {
      "enum": ["everyday", "deep"]
    },
    "param": {
      "type": "object",
      "required": ["key", "label", "kind"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$"
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "kind": {
          "enum": ["text", "choice", "multi", "time", "timezone", "project", "person", "number"]
        },
        "default": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "number"
            },
            {
              "type": "array",
              "items": { "type": "string", "maxLength": 80 },
              "maxItems": 20
            }
          ]
        },
        "required": { "type": "boolean" },
        "options": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 80 },
          "minItems": 2,
          "maxItems": 12
        },
        "help": { "type": "string", "maxLength": 160 }
      }
    },
    "alternative": {
      "oneOf": [
        {
          "type": "object",
          "required": ["preset"],
          "additionalProperties": false,
          "properties": {
            "preset": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          }
        },
        {
          "type": "object",
          "required": ["login"],
          "additionalProperties": false,
          "properties": {
            "login": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
            }
          }
        },
        {
          "type": "object",
          "required": ["secret"],
          "additionalProperties": false,
          "properties": {
            "secret": {
              "type": "object",
              "required": ["name", "kind"],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
                },
                "kind": { "const": "env" }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["cli"],
          "additionalProperties": false,
          "properties": {
            "cli": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,39}$"
            }
          }
        }
      ]
    },
    "need": {
      "description": "A capability the bundle needs and the ways to meet it. It never carries a value, and never grants autonomy: `autonomy` is what it asks the owner for to run unattended.",
      "type": "object",
      "required": ["id", "why", "required", "anyOf"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "why": { "type": "string", "minLength": 1, "maxLength": 120 },
        "required": { "type": "boolean" },
        "anyOf": {
          "type": "array",
          "items": { "$ref": "#/$defs/alternative" },
          "minItems": 1,
          "maxItems": 6
        },
        "autonomy": {
          "type": "object",
          "required": ["level", "for", "why"],
          "additionalProperties": false,
          "properties": {
            "level": { "const": "acts-on-its-own" },
            "for": {
              "type": "array",
              "items": {
                "enum": ["read", "notify", "draft", "organise"]
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "why": { "type": "string", "minLength": 1, "maxLength": 120 }
          }
        }
      }
    },
    "attribution": {
      "type": "object",
      "required": ["author", "license"],
      "additionalProperties": false,
      "properties": {
        "author": { "type": "string", "minLength": 1, "maxLength": 60 },
        "url": { "type": "string", "format": "uri", "maxLength": 200 },
        "license": {
          "enum": ["CC0-1.0", "CC-BY-4.0"]
        },
        "forkedFrom": {
          "type": "object",
          "required": ["id", "revision"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "revision": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "brain": {
      "type": "object",
      "required": ["tier"],
      "additionalProperties": false,
      "properties": {
        "tier": { "$ref": "#/$defs/tier" }
      }
    },
    "persona": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "revision",
        "title",
        "summary",
        "category",
        "tags",
        "params",
        "needs",
        "effects",
        "asksFirst",
        "minAtrium",
        "attribution",
        "description",
        "instructions",
        "playbook",
        "hello",
        "routines"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "persona" },
        "id": { "$ref": "#/$defs/id" },
        "revision": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 40 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 120 },
        "category": { "$ref": "#/$defs/category" },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
          },
          "maxItems": 16,
          "uniqueItems": true
        },
        "icon": { "$ref": "#/$defs/icon" },
        "params": {
          "type": "array",
          "items": { "$ref": "#/$defs/param" },
          "maxItems": 12
        },
        "needs": {
          "type": "array",
          "items": { "$ref": "#/$defs/need" },
          "maxItems": 8
        },
        "effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/effect" },
          "uniqueItems": true
        },
        "asksFirst": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 120 },
          "maxItems": 8
        },
        "minAtrium": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "attribution": { "$ref": "#/$defs/attribution" },
        "description": { "type": "string", "minLength": 1, "maxLength": 160 },
        "instructions": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "playbook": { "type": "string", "minLength": 1, "maxLength": 3000 },
        "hello": {
          "type": "object",
          "required": ["greeting", "ask"],
          "additionalProperties": false,
          "properties": {
            "greeting": { "type": "string", "minLength": 1, "maxLength": 160 },
            "ask": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "maxItems": 4,
              "uniqueItems": true
            }
          }
        },
        "routines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ref", "on"],
            "additionalProperties": false,
            "properties": {
              "ref": { "$ref": "#/$defs/id" },
              "on": { "type": "boolean" }
            }
          },
          "maxItems": 6
        },
        "staff": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ref"],
            "additionalProperties": false,
            "properties": {
              "ref": { "$ref": "#/$defs/id" }
            }
          },
          "maxItems": 4
        },
        "look": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,31}$"
            },
            "accessory": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,31}$"
            },
            "shape": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,31}$"
            }
          }
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "icon", "color", "guidance"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 32 },
              "icon": { "$ref": "#/$defs/icon" },
              "color": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,31}$"
              },
              "guidance": { "type": "string", "minLength": 1, "maxLength": 160 }
            }
          },
          "maxItems": 3
        },
        "brain": { "$ref": "#/$defs/brain" }
      }
    },
    "routine": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "revision",
        "title",
        "summary",
        "category",
        "tags",
        "params",
        "needs",
        "effects",
        "asksFirst",
        "minAtrium",
        "attribution",
        "prompt",
        "schedule",
        "scheduleLabel",
        "target",
        "mode"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "routine" },
        "id": { "$ref": "#/$defs/id" },
        "revision": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 40 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 120 },
        "category": { "$ref": "#/$defs/category" },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
          },
          "maxItems": 16,
          "uniqueItems": true
        },
        "icon": { "$ref": "#/$defs/icon" },
        "params": {
          "type": "array",
          "items": { "$ref": "#/$defs/param" },
          "maxItems": 12
        },
        "needs": {
          "type": "array",
          "items": { "$ref": "#/$defs/need" },
          "maxItems": 8
        },
        "effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/effect" },
          "uniqueItems": true
        },
        "asksFirst": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 120 },
          "maxItems": 8
        },
        "minAtrium": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "attribution": { "$ref": "#/$defs/attribution" },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "schedule": {
          "type": "object",
          "required": ["cron"],
          "additionalProperties": false,
          "properties": {
            "cron": { "type": "string", "pattern": "^\\S+ \\S+ \\S+ \\S+ \\S+$" },
            "tz": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        },
        "scheduleLabel": { "type": "string", "minLength": 1, "maxLength": 60 },
        "doneWhen": { "type": "string", "minLength": 1, "maxLength": 200 },
        "target": {
          "oneOf": [
            {
              "const": "director"
            },
            {
              "type": "object",
              "required": ["staff"],
              "additionalProperties": false,
              "properties": {
                "staff": { "$ref": "#/$defs/id" }
              }
            }
          ]
        },
        "mode": {
          "enum": ["standing", "on-demand"]
        },
        "runOptions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "blockOverlap": { "type": "boolean" },
            "onlyWhenIdle": { "type": "boolean" },
            "tokenBudget": { "type": "integer", "minimum": 1000 }
          }
        }
      }
    },
    "staff": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "revision",
        "title",
        "summary",
        "category",
        "tags",
        "params",
        "needs",
        "effects",
        "asksFirst",
        "minAtrium",
        "attribution",
        "description",
        "instructions",
        "brain"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "staff" },
        "id": { "$ref": "#/$defs/id" },
        "revision": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 40 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 120 },
        "category": { "$ref": "#/$defs/category" },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
          },
          "maxItems": 16,
          "uniqueItems": true
        },
        "icon": { "$ref": "#/$defs/icon" },
        "params": {
          "type": "array",
          "items": { "$ref": "#/$defs/param" },
          "maxItems": 12
        },
        "needs": {
          "type": "array",
          "items": { "$ref": "#/$defs/need" },
          "maxItems": 8
        },
        "effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/effect" },
          "uniqueItems": true
        },
        "asksFirst": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 120 },
          "maxItems": 8
        },
        "minAtrium": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "attribution": { "$ref": "#/$defs/attribution" },
        "description": { "type": "string", "minLength": 1, "maxLength": 160 },
        "instructions": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "brain": { "$ref": "#/$defs/brain" }
      }
    },
    "printable": {
      "description": "Every key and string in a bundle: printable characters, tab and newline only. No controls, format characters (zero-width joiners, bidi overrides, tag characters), separators, variation selectors or private-use or surrogate characters, which hide text from review. A portable approximation of the rule build-hq-library.mjs and atrium enforce exactly (they also refuse unassigned code points).",
      "if": { "type": "string" },
      "then": {
        "pattern": "^[^\u0000-\b\u000b-\u001f\u007f-\u009f\u00ad\u0600-\u0605\u061c\u06dd\u070f\u0890-\u0891\u08e2\u180e\u200b-\u200f\u2028-\u202e\u2060-\u206f\ue000-\uf8ff\ufe00-\ufe0f\ufeff\ufff0-\ufffb\ufffe-\uffff\ud804\udcbd\ud804\udccd\ud80d\udc30-\ud80d\udc3f\ud82f\udca0-\ud82f\udca3\ud834\udd73-\ud834\udd7a\udb40\udc00-\udb40\udc7f\udb40\udd00-\udb40\uddef\udb80\udc00-\udbff\udfff\ud800-\udfff]*$"
      },
      "else": {
        "if": { "type": "object" },
        "then": {
          "propertyNames": {
            "pattern": "^[^\u0000-\b\u000b-\u001f\u007f-\u009f\u00ad\u0600-\u0605\u061c\u06dd\u070f\u0890-\u0891\u08e2\u180e\u200b-\u200f\u2028-\u202e\u2060-\u206f\ue000-\uf8ff\ufe00-\ufe0f\ufeff\ufff0-\ufffb\ufffe-\uffff\ud804\udcbd\ud804\udccd\ud80d\udc30-\ud80d\udc3f\ud82f\udca0-\ud82f\udca3\ud834\udd73-\ud834\udd7a\udb40\udc00-\udb40\udc7f\udb40\udd00-\udb40\uddef\udb80\udc00-\udbff\udfff\ud800-\udfff]*$"
          },
          "additionalProperties": { "$ref": "#/$defs/printable" }
        },
        "else": {
          "if": { "type": "array" },
          "then": {
            "items": { "$ref": "#/$defs/printable" }
          }
        }
      }
    }
  }
}
