#!/usr/bin/env python3
from pathlib import Path
import subprocess
import sys
import tempfile

root = Path(subprocess.check_output(['git', 'rev-parse', '--show-toplevel'], text=True).strip())
with tempfile.TemporaryDirectory(prefix='atrium-adapters-index-') as temporary:
    mirror = Path(temporary)
    subprocess.run(['git', 'checkout-index', '--all', '--prefix=' + str(mirror) + '/'], cwd=root, check=True)
    subprocess.run([sys.executable, str(mirror / 'scripts/usage-output-version.py'),
                    'check', '--repository', str(root)], cwd=mirror, check=True)
    subprocess.run([sys.executable, str(mirror / 'tests/usage_output_version_test.py')], cwd=mirror, check=True)
