{
  "sdkVersion": 2,
  "name": "muse",
  "displayName": "Muse Code",
  "description": "Meta's terminal coding agent",
  "accent": "#0064e0",
  "binary": "muse",
  "updateCommand": [
    "bash",
    "-c",
    "set -o pipefail; curl -fsSL https://dev.meta.ai/install.sh | bash"
  ],
  "version": "1.0.3",
  "icon": "icon.svg",
  "skillInstallPath": "~/.config/muse/skills/atrium/SKILL.md",
  "skillsDir": "~/.config/muse/skills",
  "binaryDiscovery": {
    "commands": ["muse"],
    "wellKnownPaths": [
      "~/.local/bin/muse",
      "/usr/local/bin/muse",
      "/opt/homebrew/bin/muse",
      "~/AppData/Local/Programs/muse/muse.cmd"
    ]
  },
  "install": {
    "macos": {
      "cmd": "curl -fsSL https://dev.meta.ai/install.sh | bash",
      "postInstallAuth": true
    },
    "linux": {
      "cmd": "curl -fsSL https://dev.meta.ai/install.sh | bash",
      "postInstallAuth": true
    },
    "windows": {
      "cmd": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"irm https://dev.meta.ai/install.ps1 | iex\"",
      "postInstallAuth": true
    }
  },
  "methods": {
    "list_recent_sessions": { "script": "list_recent_sessions.sh" },
    "build_launch_command": { "script": "build_launch_command.sh" },
    "build_resume_command": { "script": "build_resume_command.sh" },
    "check_update": { "script": "check_update.sh" },
    "build_eval_command": { "script": "build_eval_command.sh" },
    "hooks": { "script": "hooks.sh" },
    "launcher_options": { "static": "launcher_options.json" }
  },
  "sessionExtractor": {
    "script": "extract_session.sh",
    "schemaVersion": 1,
    "supportsDepths": ["quick", "standard"]
  },
  "chatTransport": {
    "kind": "muse-msp",
    "args": ["serve", "--disable-sandbox", "--trust-workspace"],
    "launchEnv": {
      "MUSE_EXPERIMENTAL_WORKFLOW_API_V2_ROLLOUT": "1"
    },
    "capabilities": {
      "resume": true,
      "setModel": true,
      "thinking": true,
      "permissionCallback": true,
      "commandDiscovery": false,
      "planMode": false,
      "contextUsage": true,
      "imageInput": true,
      "checkpointing": false,
      "subagentEvents": true,
      "steering": true,
      "backgroundTasks": true,
      "conversationRewind": true
    }
  }
}
