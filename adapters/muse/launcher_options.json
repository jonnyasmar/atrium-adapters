{
  "options": [
    {
      "key": "yolo",
      "label": "🤠",
      "description": "--yolo (no approvals, no sandbox, trust this workspace)",
      "type": "toggle",
      "default": false
    },
    {
      "key": "approvalMode",
      "label": "approvals",
      "description": "--approval-mode",
      "type": "select",
      "default": "on-request",
      "choices": [
        { "value": "untrusted", "label": "Untrusted" },
        { "value": "on-request", "label": "On request" },
        { "value": "never", "label": "Never ask" }
      ]
    },
    {
      "key": "model",
      "label": "model",
      "description": "--model",
      "type": "select",
      "default": "",
      "choices": [
        {
          "value": "muse-wonder-1.0",
          "label": "Muse Wonder",
          "efforts": ["minimal", "low", "medium", "high", "xhigh", "max"]
        },
        {
          "value": "muse-spark-1.3",
          "label": "Muse Spark 1.3",
          "efforts": ["minimal", "low", "medium", "high", "xhigh", "max"]
        },
        {
          "value": "muse-spark-1.3-contributor",
          "label": "Muse Spark 1.3 (shares your content)",
          "efforts": ["minimal", "low", "medium", "high", "xhigh", "max"]
        },
        {
          "value": "muse-spark-1.2",
          "label": "Muse Spark 1.2",
          "efforts": ["minimal", "low", "medium", "high", "xhigh"]
        },
        {
          "value": "muse-spark-1.2-contributor",
          "label": "Muse Spark 1.2 (shares your content)",
          "efforts": ["minimal", "low", "medium", "high", "xhigh"]
        }
      ]
    },
    {
      "key": "effort",
      "label": "effort",
      "description": "--reasoning-effort",
      "type": "select",
      "default": "high",
      "choices": [
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    {
      "key": "extraArgs",
      "label": "args",
      "description": "Additional CLI arguments",
      "type": "text",
      "default": ""
    }
  ],
  "suggestedFlags": [
    {
      "flag": "--worktree",
      "description": "Run this session in a git worktree (bare = create)",
      "values": ["off", "create", "existing"]
    },
    {
      "flag": "--worktree-base",
      "description": "Base ref for --worktree create (default: HEAD)"
    },
    {
      "flag": "--worktree-existing",
      "description": "Existing worktree path for --worktree existing"
    },
    {
      "flag": "--permission-profile",
      "description": "Select a named permission profile for this session"
    },
    {
      "flag": "--trust-workspace",
      "description": "Trust this workspace for this run (load its skills and rules)"
    },
    {
      "flag": "--approval-judge",
      "description": "LLM approval judge for prompt-bound calls (default: on)",
      "values": ["on", "off"]
    },
    {
      "flag": "--parallel-tool-calls",
      "description": "Enable Meta API parallel tool calls"
    },
    {
      "flag": "--no-parallel-tool-calls",
      "description": "Disable Meta API parallel tool calls"
    },
    {
      "flag": "--workspace",
      "description": "Root policy-gated workspace tools at PATH"
    },
    {
      "flag": "--preset",
      "description": "Run a built-in preset",
      "values": ["native-basic", "miniswe"]
    },
    {
      "flag": "--agents",
      "description": "Supply one ephemeral agent-definition overlay (JSON)"
    },
    {
      "flag": "--base-url",
      "description": "Override the Meta provider base URL"
    },
    {
      "flag": "--image",
      "description": "Attach a local image file to the next submitted prompt"
    }
  ]
}
