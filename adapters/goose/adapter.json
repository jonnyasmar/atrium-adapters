{
  "sdkVersion": 2,
  "name": "goose",
  "displayName": "Goose",
  "description": "Block's open-source AI agent CLI (BYOK, OpenRouter and 20+ providers)",
  "accent": "#f59e0b",
  "binary": "goose",
  "version": "1.0.4",
  "binaryDiscovery": {
    "commands": [
      "goose"
    ],
    "wellKnownPaths": [
      "/opt/homebrew/bin/goose",
      "/usr/local/bin/goose",
      "~/.local/bin/goose",
      "~/.local/bin/goose.exe"
    ]
  },
  "install": {
    "macos": {
      "cmd": "brew install block-goose-cli",
      "postInstallAuth": true
    },
    "linux": {
      "cmd": "curl -fsSL https://github.com/aaif-goose/goose/releases/download/stable/download_cli.sh | CONFIGURE=false bash",
      "postInstallAuth": true
    },
    "windows": {
      "cmd": "$env:CONFIGURE='false'; irm https://raw.githubusercontent.com/block/goose/main/download_cli.ps1 | iex",
      "postInstallAuth": true
    }
  },
  "icon": "icon.svg",
  "chatTransport": {
    "kind": "acp",
    "args": [
      "acp"
    ],
    "capabilities": {
      "checkpointing": false,
      "resume": true,
      "imageInput": true,
      "setModel": true,
      "thinking": true,
      "planMode": false,
      "steering": false,
      "backgroundTasks": false,
      "subagentEvents": false,
      "commandDiscovery": true,
      "permissionCallback": true,
      "contextUsage": true
    }
  },
  "methods": {
    "build_launch_command": {
      "script": "build_launch_command.sh"
    },
    "build_resume_command": {
      "script": "build_resume_command.sh"
    },
    "list_recent_sessions": {
      "script": "list_recent_sessions.sh"
    },
    "hooks": {
      "script": "hooks.sh"
    },
    "launcher_options": {
      "static": "launcher_options.json"
    },
    "check_update": {
      "script": "check_update.sh"
    }
  },
  "hooks": {
    "session-start": "atrium://hooks/goose/session-start",
    "session-end": "atrium://hooks/goose/session-end",
    "user-prompt-submit": "atrium://hooks/goose/user-prompt-submit",
    "pre-tool-use": "atrium://hooks/goose/pre-tool-use",
    "post-tool-use": "atrium://hooks/goose/post-tool-use",
    "stop": "atrium://hooks/goose/stop"
  },
  "hookEnvelopes": {
    "sessionStartManifest": {
      "kind": "none"
    },
    "userPromptSubmit": {
      "kind": "none"
    },
    "preToolUse": {
      "kind": "none"
    },
    "postToolUse": {
      "kind": "none"
    }
  },
  "sessionExtractor": {
    "script": "extract_session.sh",
    "schemaVersion": 1,
    "supportsDepths": [
      "quick",
      "standard",
      "deep"
    ]
  },
  "skillInstallPath": "~/.config/goose/skills/atrium/SKILL.md",
  "skillsDir": "~/.config/goose/skills"
}
