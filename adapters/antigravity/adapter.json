{
  "sdkVersion": 2,
  "name": "antigravity",
  "displayName": "Antigravity",
  "description": "Google's agent-first terminal CLI (successor to Gemini CLI)",
  "accent": "#14b8a6",
  "binary": "agy",
  "version": "0.6.4",
  "updateCommand": [
    "bash",
    "-c",
    "bin=\"$(command -v agy)\"; target=\"$(readlink \"$bin\" 2>/dev/null || printf %s \"$bin\")\"; case \"$target\" in */Caskroom/*) rest=\"${target#*/Caskroom/}\"; exec brew upgrade --cask \"${rest%%/*}\" ;; */Cellar/*) rest=\"${target#*/Cellar/}\"; exec brew upgrade \"${rest%%/*}\" ;; esac; exec agy update"
  ],
  "icon": "icon.svg",
  "chatTransport": {
    "kind": "acp",
    "managedRuntime": "antigravity-acp",
    "binaryDiscovery": {
      "commands": [
        "agy_acp_server.par",
        "agy_acp_server"
      ],
      "wellKnownPaths": [
        "~/.local/share/atrium/runtimes/antigravity-acp/current/agy_acp_server.par",
        "~/.antigravity/acp/agy_acp_server.par"
      ]
    },
    "capabilities": {
      "resume": true,
      "setModel": true,
      "thinking": true,
      "permissionCallback": true,
      "commandDiscovery": true,
      "planMode": false,
      "contextUsage": true,
      "imageInput": true,
      "checkpointing": false,
      "subagentEvents": false,
      "steering": false,
      "backgroundTasks": true
    }
  },
  "skillInstallPath": "~/.gemini/antigravity-cli/skills/atrium/SKILL.md",
  "skillsDir": "~/.gemini/antigravity-cli/skills",
  "binaryDiscovery": {
    "commands": [
      "agy"
    ],
    "wellKnownPaths": [
      "/opt/homebrew/bin/agy",
      "/usr/local/bin/agy",
      "~/.local/bin/agy",
      "~/.npm/bin/agy",
      "~/AppData/Local/agy/bin/agy.exe"
    ]
  },
  "install": {
    "macos": {
      "cmd": "curl -fsSL https://antigravity.google/cli/install.sh | bash",
      "postInstallAuth": true
    },
    "linux": {
      "cmd": "curl -fsSL https://antigravity.google/cli/install.sh | bash",
      "postInstallAuth": true
    },
    "windows": {
      "cmd": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"irm https://antigravity.google/cli/install.ps1 | iex\"",
      "postInstallAuth": true
    }
  },
  "hooks": {
    "session-start": "atrium://hooks/antigravity/session-start",
    "session-end": "atrium://hooks/antigravity/session-end",
    "pre-tool-use": "atrium://hooks/antigravity/pre-tool-use",
    "post-tool-use": "atrium://hooks/antigravity/post-tool-use",
    "user-prompt-submit": "atrium://hooks/antigravity/user-prompt-submit",
    "stop": "atrium://hooks/antigravity/stop"
  },
  "methods": {
    "build_launch_command": {
      "script": "build_launch_command.sh"
    },
    "build_resume_command": {
      "script": "build_resume_command.sh"
    },
    "check_update": {
      "script": "check_update.sh"
    },
    "list_recent_sessions": {
      "script": "list_recent_sessions.sh"
    },
    "hooks": {
      "script": "hooks.sh"
    },
    "launcher_options": {
      "static": "launcher_options.json"
    }
  },
  "sessionExtractor": {
    "script": "extract_session.sh",
    "schemaVersion": 1,
    "supportsDepths": [
      "quick",
      "standard",
      "deep"
    ]
  },
  "hookEnvelopes": {
    "sessionStartManifest": {
      "kind": "identity"
    },
    "userPromptSubmit": {
      "kind": "hookSpecificOutput",
      "hookEventName": "UserPromptSubmit",
      "includeSystemMessage": false
    },
    "preToolUse": {
      "kind": "none"
    },
    "postToolUse": {
      "kind": "none"
    }
  }
}
